<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EnglishStudy.ViewModels"
        x:Class="EnglishStudy.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Estude Inglês"
        Width="1160" Height="760"
        MinWidth="880" MinHeight="540"
        Background="{StaticResource Bg}"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="250,*">

    <Border Grid.Column="0" Background="{StaticResource Surface}" Padding="14,20">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Margin="6,0,6,18" Spacing="4">
          <TextBlock Text="📘  Estude Inglês" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource Text}" TextWrapping="Wrap" />
          <TextBlock Text="seu treino diário de inglês" FontSize="12" Foreground="{StaticResource Dim}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding CurrentNav, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,7" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <TextBlock Text="{Binding Display}" FontSize="14" TextWrapping="NoWrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="8,12,8,0" FontSize="11" Foreground="{StaticResource Dim}"
                   TextWrapping="Wrap"
                   Text="Pratique um pouco todo dia. Consistência vence intensidade!" />
      </Grid>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
  </Grid>
</Window>
